title: "Intent-Driven Quality Assurance (IDQA): Working Specification and Research Agenda"
version: "0.1"
date-released: "2026-09-28"
authors:
  - family-names: "Costa"
    given-names: "Rodrigo Candido"
    affiliation: "IsenForge Research"
